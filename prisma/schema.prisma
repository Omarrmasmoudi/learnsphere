generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  password       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  admin          Admin?       @relation("UserAdmin")
  enrollments    Enrollment[]
  teacher        Teacher?     @relation("UserTeacher")
  createdCourses Course[]     @relation("createdCourses")
  age            Int?
  location       String?
  gender         String?
  interests      String?
  lastLogin      DateTime?
  watchHistory   String[] 
  ratings        Rating[]     @relation("UserRatings")
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  String
  rating    Int // Rating value (e.g., 1–5)
  createdAt DateTime @default(now())
  user      User     @relation("UserRatings", fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Course {
  id             String       @id @default(uuid())
  title          String
  description    String?
  price          Int
  image          String?
  category       String?
  duration       String?
  level          String?
  priceRange     String?      @default("$40-$100")
  createdAt      DateTime     @default(now())
  instructorId   Int
  instructorName String
  published      Boolean      @default(false)
  updatedAt      DateTime     @updatedAt
  video          String?
  enrollments    Enrollment[]
  instructor     User         @relation("createdCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  sections       Section[]
  Rating         Rating[]

  @@map("courses")
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    String
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())
  status      String    @default("IN_PROGRESS")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Teacher {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserTeacher", fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserAdmin", fields: [userId], references: [id], onDelete: Cascade)
}

model Section {
  id        Int      @id @default(autoincrement())
  title     String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos    Video[]

  @@map("sections")
}

model Video {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  sectionId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("videos")
}
