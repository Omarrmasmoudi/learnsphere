datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  password       String
  createdCourses Course[]     @relation("createdCourses")
  enrollments    Enrollment[]
  teacher        Teacher?     @relation("UserTeacher")
  admin          Admin?       @relation("UserAdmin")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String?
  instructorId Int
  instructor   User         @relation("createdCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  price        Int
  image        String?
  video        String?
  category     String?
  duration     String?
  level        String?
  priceRange   String?      @default("$40-$100")
  published    Boolean      @default(false)
  enrollments  Enrollment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("courses")
}

model Enrollment {
  id          Int       @id @default(autoincrement())
  userId      Int
  courseId    String
  status      String    @default("IN_PROGRESS")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Teacher {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserTeacher", fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation("UserAdmin", fields: [userId], references: [id], onDelete: Cascade)
}
