# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnsphere"

# Secret used to sign session JWTs. Use a long random value, e.g. `openssl rand -base64 32`
JWT_SECRET=""

# Public base URL of the app (used for server-side fetches)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# UploadThing credentials (https://uploadthing.com)
UPLOADTHING_TOKEN=""
